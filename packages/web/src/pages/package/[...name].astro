---
import PluginDetail from '@/components/PluginDetail.astro'
import Layout from '@/layouts/Layout.astro'
import { getBlogsForPlugin } from '@/lib/blogs'
import { getCanonicalPlugins, pluginId } from '@/lib/plugins'
import { npmRoute } from '@/lib/urls'

export const prerender = true

export async function getStaticPaths() {
  const byName = new Map<string, (typeof entries)[number]>()
  const entries = await getCanonicalPlugins()
  for (const entry of entries) {
    const name = entry.data.npm?.name
    if (!name) continue
    const key = name.toLowerCase()
    // First match wins, mirroring getPluginByNpm.
    if (!byName.has(key)) byName.set(key, entry)
  }
  return [...byName.values()].map((entry) => ({
    params: { name: entry.data.npm!.name },
    props: { entry },
  }))
}

const { entry } = Astro.props
const blogs = await getBlogsForPlugin(pluginId(entry))
---

<Layout
  title={entry.data.name}
  description={`${entry.data.name} npm package and DSH compatibility reference.`}
  canonical={npmRoute(entry.data.npm!.name)}
>
  <PluginDetail entry={entry} blogs={blogs} context="npm" />
</Layout>
