---
import PaginationParts from '@/components/starwind/pagination'
import Layout from '@/layouts/Layout.astro'
import SearchModal from '@/components/SearchModal.astro'
import { getCanonicalPlugins, pluginId } from '@/lib/plugins'
import { pluginUrl } from '@/lib/urls'
import ArrowRight from '@tabler/icons/outline/arrow-right.svg'
import styles from './index.module.scss'

const plugins = (await getCanonicalPlugins()).sort((left, right) =>
  left.data.name.localeCompare(right.data.name),
)
const pageParam = Number(Astro.url.searchParams.get('page') ?? '1')
const perPage = 36
const pageCount = Math.max(1, Math.ceil(plugins.length / perPage))
const page = Number.isInteger(pageParam)
  ? Math.min(Math.max(1, pageParam), pageCount)
  : 1
const entries = plugins.slice((page - 1) * perPage, page * perPage)
const pageUrl = (target: number): string => {
  const params = new URLSearchParams()
  if (target > 1) params.set('page', String(target))
  const value = params.toString()
  return value ? `/?${value}` : '/'
}
const pageNumbers = Array.from(
  new Set(
    [1, page - 1, page, page + 1, pageCount].filter(
      (value) => value > 0 && value <= pageCount,
    ),
  ),
)
---

<Layout
  title="DSH Plugins"
  description="Browse GitHub repositories, npm packages, and package versions in the DSH plugin index."
>
  <div class={styles.page}>
    <header class={styles.header}>
      <div>
        <h1 class={styles.title}>DSH plugin index</h1>
        <p class={styles.intro}>
          A source-neutral reference for package identities, repository
          coordinates, and DSH compatibility.
        </p>
      </div>
      <div
        class={styles.count}
        aria-label={`${plugins.length} indexed plugins`}
      >
        <strong>{plugins.length.toLocaleString()}</strong>
        indexed plugins
      </div>
    </header>

    <div class={styles.searchTrigger}>
      <SearchModal />
    </div>

    <section aria-labelledby="results-heading">
      <div class={styles.resultsHeader}>
        <h2 id="results-heading" class={styles.resultsTitle}>All plugins</h2>
        <span class={styles.resultCount}>
          {plugins.length.toLocaleString()} plugins · page {page} of {pageCount}
        </span>
      </div>

      {
        entries.length > 0 ? (
          <div class={styles.list}>
            {entries.map((entry) => {
              const data = entry.data
              const latest = data.versions.at(-1)?.packageVersion
              const repository = data.github
                ? `${data.github.owner}/${data.github.repo}`
                : undefined
              return (
                <a class={styles.row} href={pluginUrl(pluginId(entry))}>
                  <span class={styles.id}>#{pluginId(entry)}</span>
                  <span class={styles.nameBlock}>
                    <span class={styles.name}>{data.name}</span>
                    {repository && (
                      <span class={styles.repository}>
                        {repository}
                        {data.github?.path ? `/${data.github.path}` : ''}
                      </span>
                    )}
                  </span>
                  <span class={styles.package}>
                    {data.npm?.name ?? 'GitHub source'}
                  </span>
                  <span class={styles.version}>
                    {latest ? `v${latest}` : 'No version'}
                  </span>
                  <ArrowRight class={styles.arrow} aria-hidden="true" />
                </a>
              )
            })}
          </div>
        ) : (
          <div class={styles.empty}>
            <h3 class={styles.emptyTitle}>No plugins indexed yet</h3>
          </div>
        )
      }
    </section>

    {
      pageCount > 1 && (
        <PaginationParts.Root class={styles.pagination}>
          <PaginationParts.Content>
            {page > 1 && (
              <PaginationParts.Previous href={pageUrl(page - 1)}>
                Previous
              </PaginationParts.Previous>
            )}
            {pageNumbers.map((number) => (
              <PaginationParts.Item>
                <PaginationParts.Link
                  href={pageUrl(number)}
                  isActive={number === page}
                >
                  {number}
                </PaginationParts.Link>
              </PaginationParts.Item>
            ))}
            {page < pageCount && (
              <PaginationParts.Next href={pageUrl(page + 1)}>
                Next
              </PaginationParts.Next>
            )}
          </PaginationParts.Content>
        </PaginationParts.Root>
      )
    }
  </div>
</Layout>
