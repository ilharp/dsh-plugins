---
import PluginDetail from '@/components/PluginDetail.astro'
import Layout from '@/layouts/Layout.astro'
import { getPlugins, isPlugin, pluginId } from '@/lib/plugins'
import { getPostsForPlugin } from '@/lib/posts'
import { pluginUrl } from '@/lib/urls'

export const prerender = true

export async function getStaticPaths() {
  const entries = (await getPlugins()).filter(isPlugin)
  return entries.map((entry) => {
    const id = pluginId(entry)
    return { params: { id: String(id) }, props: { entry } }
  })
}

const { entry } = Astro.props
const id = pluginId(entry)
const posts = await getPostsForPlugin(id)
---

<Layout
  title={entry.data.name}
  description={`${entry.data.name} package and compatibility reference.`}
  canonical={pluginUrl(id)}
>
  <PluginDetail entry={entry} posts={posts} context="plugin" />
</Layout>
