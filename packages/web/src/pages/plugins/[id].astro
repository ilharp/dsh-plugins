---
import NotFound from '@/components/NotFound.astro'
import PluginDetail from '@/components/PluginDetail.astro'
import Layout from '@/layouts/Layout.astro'
import { getPluginById, isPlugin, isRedirect } from '@/utils/plugins'
import { getPostsForPlugin } from '@/utils/posts'
import { pluginUrl } from '@/utils/urls'

export const prerender = false

// export async function getStaticPaths() {
//   const entries = (await getPlugins()).filter(isPlugin)
//   return entries.map((entry) => {
//     const id = pluginId(entry)
//     return { params: { id: String(id) }, props: { entry } }
//   })
// }

const id = Number(Astro.params.id)
const entry =
  Number.isInteger(id) && id > 0 ? await getPluginById(id) : undefined

if (entry && isRedirect(entry.data)) {
  return Astro.redirect(pluginUrl(entry.data.redirect), 301)
}

if (!entry || !isPlugin(entry)) Astro.response.status = 404
const posts = entry && isPlugin(entry) ? await getPostsForPlugin(id) : []
---

<Layout
  title={entry && isPlugin(entry) ? entry.data.name : '页面不存在'}
  description={entry && isPlugin(entry)
    ? `${entry.data.name} 的包信息与 DSH 兼容版本。`
    : '请求的页面不存在。'}
  canonical={entry && isPlugin(entry) ? pluginUrl(id) : Astro.url.pathname}
>
  {
    entry && isPlugin(entry) ? (
      <PluginDetail entry={entry} posts={posts} context="plugin" />
    ) : (
      <NotFound title="插件不存在" />
    )
  }
</Layout>
