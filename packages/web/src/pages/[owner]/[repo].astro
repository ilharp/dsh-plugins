---
import PluginDetail from '@/components/PluginDetail.astro'
import RepositoryDetail from '@/components/RepositoryDetail.astro'
import Layout from '@/layouts/Layout.astro'
import { getBlogsForPlugin } from '@/lib/blogs'
import { getCanonicalPlugins, pluginId } from '@/lib/plugins'

export const prerender = true

export async function getStaticPaths() {
  const byRepository = new Map<string, (typeof entries)[number][]>()
  const entries = await getCanonicalPlugins()
  for (const entry of entries) {
    const github = entry.data.github
    if (!github) continue
    const key = `${github.owner.toLowerCase()}/${github.repo.toLowerCase()}`
    if (!byRepository.has(key)) byRepository.set(key, [])
    byRepository.get(key)!.push(entry)
  }
  return [...byRepository.values()].map((group) => {
    const { owner, repo } = group[0].data.github!
    // Encoded form matches githubRoute so links and routes always agree.
    return {
      params: {
        owner: encodeURIComponent(owner),
        repo: encodeURIComponent(repo),
      },
      props: { entries: group },
    }
  })
}

const { entries } = Astro.props
const entry = entries.length === 1 ? entries[0] : undefined
const blogs = entry ? await getBlogsForPlugin(pluginId(entry)) : []
---

<Layout
  title={entry
    ? entry.data.name
    : `${entries[0].data.github!.owner}/${entries[0].data.github!.repo}`}
  description={entry
    ? `${entry.data.name} GitHub repository and DSH compatibility reference.`
    : `Indexed DSH plugins in ${entries[0].data.github!.owner}/${entries[0].data.github!.repo}.`}
  canonical={Astro.url.pathname}
>
  {
    entry ? (
      <PluginDetail entry={entry} blogs={blogs} context="github" />
    ) : (
      <RepositoryDetail entries={entries} />
    )
  }
</Layout>
