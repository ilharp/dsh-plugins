//     if (!github) continue
//     const key = `${github.owner.toLowerCase()}/${github.repo.toLowerCase()}`
//     if (!byRepository.has(key)) byRepository.set(key, [])
//     byRepository.get(key)!.push(entry)
//   }
//   return [...byRepository.values()].map((group) => {
//     const { owner, repo } = group[0].data.github!
//     // Encoded form matches githubRoute so links and routes always agree.
//     return {
//       params: {
//         owner: encodeURIComponent(owner),
//         repo: encodeURIComponent(repo),
//       },
//       props: { entries: group },
//     }
//   })
// }

let owner = Astro.params.owner ?? ''
let repo = Astro.params.repo ?? ''
try {
  owner = decodeURIComponent(owner)
  repo = decodeURIComponent(repo)
} catch {
  owner = ''
  repo = ''
}
const entries = owner && repo ? await getPluginsByRepository(owner, repo) : []
if (entries.length === 0) Astro.response.status = 404
const entry = entries.length === 1 ? entries[0] : undefined
const posts = entry ? await getPostsForPlugin(pluginId(entry)) : []
---

<Layout
  title={entry
    ? entry.data.name
    : entries.length > 1
      ? `${owner}/${repo}`
      : '页面不存在'}
  description={entry
    ? `${entry.data.name} 的 GitHub 仓库信息与 DSH 兼容版本。`
    : entries.length > 1
      ? `${owner}/${repo} 中收录的 DSH 插件。`
      : '请求的页面不存在。'}
  canonical={Astro.url.pathname}
>
  {
    entry ? (
      <PluginDetail entry={entry} posts={posts} context="github" />
    ) : entries.length > 1 ? (
      <RepositoryDetail entries={entries} />
    ) : (
      <NotFound title="仓库不存在" />
    )
  }
</Layout>
