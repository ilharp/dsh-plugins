import PluginDetail from '@/components/PluginDetail.astro'
import RepositoryDetail from '@/components/RepositoryDetail.astro'
import Layout from '@/layouts/Layout.astro'
import { getPluginsByRepository, pluginId } from '@/utils/plugins'
import { getPostsForPlugin } from '@/utils/posts'

