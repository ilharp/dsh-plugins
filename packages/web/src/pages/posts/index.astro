---
import Layout from '@/layouts/Layout.astro'
import { getPosts } from '@/utils/posts'
import { postUrl } from '@/utils/urls'
import styles from './index.module.scss'

export const prerender = true

const posts = (await getPosts()).sort((left, right) =>
  (right.data.publishedAt ?? '').localeCompare(left.data.publishedAt ?? ''),
)
---

<Layout
  title="文章"
  description="关于 DSH 插件的文章与使用笔记。"
  canonical="/posts"
>
  <section class={styles.index}>
    <header class={styles.indexHeader}>
      <h1 class={styles.title}>文章</h1>
      <p class={styles.intro}>
        为收录的插件撰写的介绍文章，包含功能说明与上手方法。
      </p>
    </header>
    {
      posts.length > 0 ? (
        <div class={styles.list}>
          {posts.map((post) => (
            <a class={styles.item} href={postUrl(post.id)}>
              <h2 class={styles.itemTitle}>{post.data.title}</h2>
              {post.data.description && (
                <p class={styles.itemDescription}>{post.data.description}</p>
              )}
              <div class={styles.meta}>
                {post.data.publishedAt && <span>{post.data.publishedAt}</span>}
                {post.data.author && <span>{post.data.author}</span>}
                {post.data.plugin && <span>插件 #{post.data.plugin}</span>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class={styles.empty}>还没有发布文章。</p>
      )
    }
  </section>
</Layout>
