---
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'
import { getBlogs } from '@/lib/blogs'
import { getPluginById, isPlugin } from '@/lib/plugins'
import { blogUrl, pluginUrl } from '@/lib/urls'
import { render } from 'astro:content'
import styles from './blog.module.scss'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getBlogs()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const rendered = await render(post)
const Content = rendered.Content
const plugin = post.data.plugin
  ? await getPluginById(post.data.plugin)
  : undefined
const linkedPlugin = plugin && isPlugin(plugin) ? plugin : undefined
---

<Layout
  title={post.data.title}
  description={post.data.description ?? 'An article from the DSH plugin index.'}
  canonical={blogUrl(post.id)}
>
  <article class={styles.article}>
    <header class={styles.articleHeader}>
      <h1 class={styles.articleTitle}>{post.data.title}</h1>
      {
        post.data.description && (
          <p class={styles.articleDescription}>{post.data.description}</p>
        )
      }
      <div class={styles.meta}>
        {
          post.data.publishedAt && (
            <time datetime={post.data.publishedAt}>
              {post.data.publishedAt}
            </time>
          )
        }
        {post.data.updatedAt && <span>Updated {post.data.updatedAt}</span>}
        {post.data.author && <span>{post.data.author}</span>}
      </div>
    </header>
    <div class={styles.prose}>
      <Content />
    </div>
    {
      linkedPlugin && post.data.plugin && (
        <aside class={styles.related}>
          <span class={styles.relatedLabel}>Related plugin</span>
          <Button
            as="a"
            href={pluginUrl(post.data.plugin)}
            variant="outline"
            size="sm"
          >
            {linkedPlugin.data.name}
          </Button>
        </aside>
      )
    }
  </article>
</Layout>
