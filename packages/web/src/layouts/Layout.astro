---
import { ThemeToggle } from '@/components/starwind/theme-toggle'
import '@/styles/site.scss'
import '@/styles/starwind.css'
import { ThemeInitScript } from '@starwind-ui/astro/theme'
import styles from './Layout.module.scss'

interface Props {
  title?: string
  description?: string
  canonical?: string
}

const {
  title = 'DSH Plugins',
  description = '收录 DeepSeek Harness 插件的包名、仓库与版本兼容信息。',
  canonical = Astro.url.pathname,
} = Astro.props
const pageTitle = title === 'DSH Plugins' ? title : `${title} · DSH Plugins`
const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url.origin)
const pathname = Astro.url.pathname
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    <ThemeInitScript />
  </head>
  <body>
    <div class={styles.page}>
      <a class={styles.skipLink} href="#main-content">跳到主要内容</a>
      <header class={styles.header}>
        <div class={styles.headerInner}>
          <a class={styles.brand} href="/" aria-label="DP — DSH Plugins 首页">
            <span class={styles.brandMark} aria-hidden="true">DP</span>
            <span class={styles.brandLabel}>DSH Plugins</span>
          </a>
          <nav class={styles.nav} aria-label="主导航">
            <a
              class={styles.navLink}
              href="/"
              aria-current={pathname === '/' ? 'page' : undefined}>插件</a
            >
            <a
              class={styles.navLink}
              href="/search"
              aria-current={pathname.startsWith('/search') ? 'page' : undefined}
              >搜索</a
            >
            <a
              class={styles.navLink}
              href="/posts"
              aria-current={pathname === '/posts' || pathname.startsWith('/p/')
                ? 'page'
                : undefined}>文章</a
            >
            <ThemeToggle ariaLabel="切换深浅色主题" size="sm" />
          </nav>
        </div>
      </header>
      <main id="main-content" class={styles.main}>
        <slot />
      </main>
      <footer class={styles.footer}>
        <div class={styles.footerInner}>
          <span>独立的 DSH 社区插件目录。</span>
          <a
            class={styles.footerLink}
            href="https://github.com/deepseek-ai/deepseek-harness"
            >DeepSeek Harness</a
          >
        </div>
      </footer>
    </div>
  </body>
</html>
