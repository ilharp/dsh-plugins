---
import { Button } from '@/components/starwind/button'
import type { PluginData } from '@/lib/plugins'
import { pluginId } from '@/lib/plugins'
import { pluginUrl } from '@/lib/urls'
import ArrowRight from '@tabler/icons/outline/arrow-right.svg'
import type { CollectionEntry } from 'astro:content'
import styles from './RepositoryDetail.module.scss'

interface Props {
  entries: Array<CollectionEntry<'plugin'> & { data: PluginData }>
}

const { entries } = Astro.props
const repository = entries[0]?.data.github
const label = repository ? `${repository.owner}/${repository.repo}` : '仓库'
---

<article class={styles.page}>
  <header class={styles.hero}>
    <h1 class={styles.title}>{label}</h1>
    <p class={styles.copy}>
      该仓库收录了 {entries.length} 个插件，选择对应路径查看详情。
    </p>
  </header>
  <div class={styles.list}>
    {
      entries.map((entry) => (
        <article class={styles.item}>
          <span class={styles.id}>#{pluginId(entry)}</span>
          <div>
            <div class={styles.name}>{entry.data.name}</div>
            <div class={styles.path}>
              {entry.data.github?.path ?? '仓库根目录'}
            </div>
          </div>
          <span class={styles.package}>
            {entry.data.npm?.name ?? '无 npm 包'}
          </span>
          <Button
            as="a"
            href={pluginUrl(pluginId(entry))}
            variant="outline"
            size="sm"
          >
            打开
            <ArrowRight aria-hidden="true" />
          </Button>
        </article>
      ))
    }
  </div>
</article>
