---
import { Button } from '@/components/starwind/button'
import styles from './NotFound.module.scss'

interface Props {
  title?: string
  message?: string
}

const {
  title = '页面不存在',
  message = '请求的地址不对应本索引中的插件或文章。',
} = Astro.props
---

<section class={styles.root}>
  <p class={styles.code}>HTTP 404</p>
  <h1 class={styles.title}>{title}</h1>
  <p class={styles.copy}>{message}</p>
  <Button as="a" href="/" variant="outline">返回插件列表</Button>
</section>
