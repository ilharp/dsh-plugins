---
import BreadcrumbParts from '@/components/starwind/breadcrumb'
import { Button } from '@/components/starwind/button'
import TableParts from '@/components/starwind/table'
import { installCommand } from '@/utils/install'
import type { PluginData } from '@/utils/plugins'
import { pluginId } from '@/utils/plugins'
import {
  githubRoute,
  githubUrl,
  npmRoute,
  npmUrl,
  pluginUrl,
  postUrl,
} from '@/utils/urls'
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg'
import Article from '@tabler/icons/outline/article.svg'
import Box from '@tabler/icons/outline/box.svg'
import BrandGithub from '@tabler/icons/outline/brand-github.svg'
import Hash from '@tabler/icons/outline/hash.svg'
import type { CollectionEntry } from 'astro:content'
import InstallPanel from './InstallPanel.astro'
import styles from './PluginDetail.module.scss'

interface Props {
  entry: CollectionEntry<'plugin'> & { data: PluginData }
  posts?: CollectionEntry<'posts'>[]
  context?: 'plugin' | 'npm' | 'github'
}

const { entry, posts = [], context = 'plugin' } = Astro.props
const data = entry.data
const id = pluginId(entry)
const command = installCommand(data)
const repositoryName = data.github
  ? `${data.github.owner}/${data.github.repo}`
  : undefined
const metadata = data.github
  ? [
      ['语言', data.github.language],
      ['许可证', data.github.license],
      ['Star 数', data.github.stars?.toLocaleString()],
      ['Fork 数', data.github.forks?.toLocaleString()],
      ['开放 issue', data.github.openIssues?.toLocaleString()],
      ['仓库路径', data.github.path],
    ].filter((item): item is [string, string] => Boolean(item[1]))
  : []
const canonical = pluginUrl(id)
---

<article class={styles.page}>
  <BreadcrumbParts.Root class={styles.breadcrumbs}>
    <BreadcrumbParts.List>
      <BreadcrumbParts.Item
        ><BreadcrumbParts.Link href="/">插件</BreadcrumbParts.Link
        ></BreadcrumbParts.Item
      >
      <BreadcrumbParts.Separator />
      <BreadcrumbParts.Item
        ><BreadcrumbParts.Page>{data.name}</BreadcrumbParts.Page
        ></BreadcrumbParts.Item
      >
    </BreadcrumbParts.List>
  </BreadcrumbParts.Root>

  <header class={styles.hero}>
    <div class={styles.identity}>
      <h1 class={styles.title}>{data.name}</h1>
      <div class={styles.coordinates} aria-label="插件标识">
        <span class={styles.coordinate}>plugin:{id}</span>
        {
          repositoryName && (
            <span class={styles.coordinate}>
              github:{repositoryName}
              {data.github?.path ? `/${data.github.path}` : ''}
            </span>
          )
        }
        {data.npm && <span class={styles.coordinate}>npm:{data.npm.name}</span>}
      </div>
    </div>
    <InstallPanel command={command} />
  </header>

  <div class={styles.body}>
    <div class={styles.mainColumn}>
      <section class={styles.section} aria-labelledby="notes-heading">
        <h2 id="notes-heading" class={styles.sectionHeading}>插件说明</h2>
        <div class={styles.notes}>
          <p>暂无补充说明。</p>
        </div>
      </section>

      <section class={styles.section} aria-labelledby="versions-heading">
        <h2 id="versions-heading" class={styles.sectionHeading}>版本</h2>
        {
          data.versions.length > 0 ? (
            <div class={styles.tableShell}>
              <TableParts.Root>
                <TableParts.Header>
                  <TableParts.Row>
                    <TableParts.Head>包版本</TableParts.Head>
                    <TableParts.Head>DSH 版本</TableParts.Head>
                  </TableParts.Row>
                </TableParts.Header>
                <TableParts.Body>
                  {data.versions.map((version) => (
                    <TableParts.Row>
                      <TableParts.Cell>
                        <code class={styles.version}>
                          {version.packageVersion}
                        </code>
                      </TableParts.Cell>
                      <TableParts.Cell>
                        <code class={styles.version}>{version.dshVersion}</code>
                      </TableParts.Cell>
                    </TableParts.Row>
                  ))}
                </TableParts.Body>
              </TableParts.Root>
            </div>
          ) : (
            <p class={styles.emptyVersions}>尚未收录版本信息。</p>
          )
        }
      </section>

      {
        metadata.length > 0 && (
          <section class={styles.section} aria-labelledby="repository-heading">
            <h2 id="repository-heading" class={styles.sectionHeading}>
              仓库
            </h2>
            <dl class={styles.metadata}>
              {metadata.map(([label, value]) => (
                <div class={styles.metric}>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        posts.length > 0 && (
          <section class={styles.section} aria-labelledby="writing-heading">
            <h2 id="writing-heading" class={styles.sectionHeading}>
              相关文章
            </h2>
            <div class={styles.postList}>
              {posts.map((post) => (
                <a class={styles.postLink} href={postUrl(post.id)}>
                  <span class={styles.postTitle}>{post.data.title}</span>
                  <span class={styles.postDate}>
                    {post.data.publishedAt ?? '文章'}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class={styles.sidebar} aria-label="插件链接">
      <section class={styles.sidebarSection}>
        <h2 class={styles.sidebarHeading}>站内跳转</h2>
        <Button
          class={styles.link}
          as="a"
          href={canonical}
          variant="outline"
          size="sm"
          aria-current={context === 'plugin' ? 'page' : undefined}
        >
          插件 #{id}<Hash aria-hidden="true" />
        </Button>
        {
          data.github && (
            <Button
              class={styles.link}
              as="a"
              href={githubRoute(data.github)}
              variant="outline"
              size="sm"
              aria-current={context === 'github' ? 'page' : undefined}
            >
              仓库
              <BrandGithub aria-hidden="true" />
            </Button>
          )
        }
        {
          data.npm && (
            <Button
              class={styles.link}
              as="a"
              href={npmRoute(data.npm.name)}
              variant="outline"
              size="sm"
              aria-current={context === 'npm' ? 'page' : undefined}
            >
              包
              <Box aria-hidden="true" />
            </Button>
          )
        }
      </section>

      <section class={styles.sidebarSection}>
        <h2 class={styles.sidebarHeading}>外部链接</h2>
        {
          data.github && (
            <Button
              class={styles.link}
              as="a"
              href={githubUrl(data.github)}
              target="_blank"
              rel="noreferrer"
              variant="ghost"
              size="sm"
            >
              GitHub
              <ArrowUpRight aria-hidden="true" />
            </Button>
          )
        }
        {
          data.npm && (
            <Button
              class={styles.link}
              as="a"
              href={npmUrl(data.npm.name)}
              target="_blank"
              rel="noreferrer"
              variant="ghost"
              size="sm"
            >
              npm
              <ArrowUpRight aria-hidden="true" />
            </Button>
          )
        }
        {
          posts.length > 0 && (
            <Button
              class={styles.link}
              as="a"
              href={postUrl(posts[0].id)}
              variant="ghost"
              size="sm"
            >
              文章
              <Article aria-hidden="true" />
            </Button>
          )
        }
      </section>
    </aside>
  </div>
</article>
